@model IEnumerable<InventoryManagement.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<h2 class="mb-4">Suppliers</h2>

@if (User.IsInRole("Manager") || User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary mb-3">➕ Create New Supplier</a>
    </p>
}

<div class="row g-4">
    @foreach (var supplier in Model)
    {
        <div class="col-md-4 col-sm-6">
            <div class="card supplier-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-primary">@supplier.Name</h5>
                    <p class="card-text"><strong>📞 Contact:</strong> @supplier.ContactInfo</p>
                    <p class="card-text"><strong>📍 Address:</strong> @supplier.Address</p>

                    <div class="mt-auto">
                        <a asp-action="Details" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-outline-info">Details</a>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a asp-action="Edit" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-outline-warning ms-1">Edit</a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .supplier-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.3s ease;
    }

        .supplier-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.25);
        }

        .supplier-card h5 {
            font-weight: 600;
            margin-bottom: 10px;
        }

        .supplier-card .btn {
            border-radius: 20px;
            font-size: 0.8rem;
            transition: all 0.2s ease;
        }

            .supplier-card .btn:hover {
                transform: translateY(-2px);
            }
</style>
