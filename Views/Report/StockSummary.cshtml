@model IEnumerable<InventoryManagement.ViewModels.ProductDto>

@{
    ViewData["Title"] = "Stock Summary";
}

<h2 class="mb-4">📦 Stock Summary</h2>

<!-- Cards Layout -->
<div class="row">
    @foreach (var product in Model)
    {
        var stockStatus = product.StockQuantity == 0 ? "Out of Stock" :
        product.StockQuantity <= product.LowStockThreshold ? "Low Stock" : "In Stock";

        var badgeClass = stockStatus == "Out of Stock" ? "bg-danger" :
        stockStatus == "Low Stock" ? "bg-warning text-dark" : "bg-success";

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold">@product.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">SKU: @product.SKU</h6>
                    <p class="mb-1"><strong>Category:</strong> @product.CategoryName</p>
                    <p class="mb-1"><strong>Supplier:</strong> @product.SupplierName</p>
                    <p class="mb-1">
                        <strong>Stock:</strong>
                        <span class="badge @badgeClass">
                            @product.StockQuantity
                        </span>
                    </p>
                    <p class="mb-0">
                        <strong>Low Threshold:</strong> @product.LowStockThreshold
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<hr />

