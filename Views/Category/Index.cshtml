@model IEnumerable<InventoryManagement.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (User.IsInRole("Manager") || User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Category</a>
    </p>
}

<!-- 🔹 Card Layout -->
<div class="row">
    @foreach (var category in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 border-0 category-card">
                <div class="card-body">
                    <h5 class="card-title">@category.Name</h5>
                    <p class="card-text">
                        <strong>Description:</strong> @category.Description
                    </p>

                    <div class="mt-3">
                        <a asp-action="Details" asp-route-id="@category.CategoryId"
                           class="btn btn-info btn-sm">Details</a>

                        @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@category.CategoryId"
                               class="btn btn-success btn-sm">Edit</a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@category.CategoryId"
                               class="btn btn-danger btn-sm">Delete</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- 🔹 Card Hover Styles -->
<style>
    .category-card {
        transition: transform 0.2s ease, box-shadow 0.3s ease;
    }

        .category-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 20px rgba(0,0,0,0.2);
        }
</style>
