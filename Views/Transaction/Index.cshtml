@model IEnumerable<InventoryManagement.Models.InventoryTransaction>

@{
    ViewData["Title"] = "Transactions";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- 🔹 Quick Action Buttons -->
<div class="mb-3">
    <a asp-action="RecordPurchase" class="btn btn-primary me-2">
        <i class="bi bi-plus-circle"></i> Record Purchase
    </a>
    <a asp-action="RecordSale" class="btn btn-secondary">
        <i class="bi bi-dash-circle"></i> Record Sale
    </a>
</div>

<!-- 🔹 Card Layout -->
<div class="row">
    @foreach (var transaction in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 border-0 transaction-card">
                <div class="card-body">
                    <h5 class="card-title">
                        @transaction.Product?.Name
                        @if (transaction.TransactionType == "IN")
                        {
                            <span class="badge bg-success ms-2">IN</span>
                        }
                        else
                        {
                            <span class="badge bg-danger ms-2">OUT</span>
                        }
                    </h5>
                    <p class="card-text">
                        <strong>Quantity:</strong> @transaction.Quantity <br />
                        <strong>Date:</strong> @transaction.Timestamp.ToString("g") <br />
                        <strong>Notes:</strong> @transaction.Notes <br />
                        <strong>Performed By:</strong> @transaction.PerformedBy.FullName
                    </p>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-action="Delete" asp-route-id="@transaction.TransactionId"
                           class="btn btn-danger btn-sm mt-2"
                           onclick="return confirm('Are you sure you want to delete this transaction? This will also revert stock.');">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- 🔹 Card Hover Styles -->
<style>
    .transaction-card {
        transition: transform 0.2s ease, box-shadow 0.3s ease;
    }

        .transaction-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 20px rgba(0,0,0,0.2);
        }
</style>
