@model IEnumerable<InventoryManagement.Models.InventoryTransaction>

@{
    ViewData["Title"] = "Transactions";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- 🔹 Quick Action Buttons -->
<div class="mb-3">
    <a asp-action="RecordPurchase" class="btn btn-primary me-2">
        <i class="bi bi-plus-circle"></i> Record Purchase
    </a>
    <a asp-action="RecordSale" class="btn btn-secondary">
        <i class="bi bi-dash-circle"></i> Record Sale
    </a>
</div>


<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Type</th>
            <th>Timestamp</th>
            <th>Notes</th>
            <th>Performed By</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var transaction in Model)
        {
            <tr>
                <td>@transaction.Product?.Name</td>
                <td>@transaction.Quantity</td>
                <td>
                    @if (transaction.TransactionType == "IN")
                    {
                        <span class="badge bg-success">IN</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">OUT</span>
                    }
                </td>
                <td>@transaction.Timestamp.ToString("g")</td>
                <td>@transaction.Notes</td>
                <td>@transaction.PerformedByUserId</td>
            </tr>
        }
    </tbody>
</table>
