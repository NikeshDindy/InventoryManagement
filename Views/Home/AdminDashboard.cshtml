@{
    ViewData["Title"] = "Admin Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <p>Welcome, <strong>@User.Identity.Name</strong>!</p>

    <div class="row g-4 mt-4">
        <!-- Register New User -->
        <div class="col-md-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Register User</h5>
                    <p class="card-text">Create new admin, manager, or staff accounts.</p>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light mt-2">Go</a>
                </div>
            </div>
        </div>

        <!-- Manage Categories -->
        <div class="col-md-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Categories</h5>
                    <p class="card-text">Add, edit, or delete product categories.</p>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-light mt-2">Go</a>
                </div>
            </div>
        </div>

        <!-- Manage Suppliers -->
        <div class="col-md-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Suppliers</h5>
                    <p class="card-text">Add or update supplier information.</p>
                    <a asp-controller="Supplier" asp-action="Index" class="btn btn-light mt-2">Go</a>
                </div>
            </div>
        </div>

        <!-- Reports -->
        <div class="col-md-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Reports</h5>
                    <p class="card-text">View sales, inventory, and other reports.</p>
                    <a asp-controller="Report" asp-action="StockSummary" class="btn btn-light mt-2">Go</a>
                </div>
            </div>
        </div>
        <div class="row g-4 mt-4">
            <!--Products-->
            <div class="col-md-3">
                <div class="card text-white bg-primary h-100">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <h5 class="card-title">Products</h5>
                        <p class="card-text">Browse available products and stock levels.</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-light mt-2">View</a>
                    </div>
                </div>
            </div>
            <!--Orders-->
            <div class="col-md-3">
                <div class="card text-white bg-warning h-100">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <h5 class="card-title">Orders</h5>
                        <p class="card-text">View all purchase and sales orders.</p>
                        <a asp-controller="Order" asp-action="Index" class="btn btn-light mt-2">View</a>
                    </div>
                </div>
            </div>
            <!--Transactions-->
            <div class="col-md-3">
                <div class="card text-white bg-dark h-100">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <h5 class="card-title">Transactions</h5>
                        <p class="card-text">View all inventory transactions.</p>
                        <a asp-controller="Transaction" asp-action="Index" class="btn btn-light mt-2">View</a>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>

