@section Styles {
    <style>
        /* Card hover effect */
        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.8rem 1.2rem rgba(0,0,0,0.15);
            transition: all 0.3s ease;
        }

        /* Table row hover lighting */
        #stockTable tbody tr:hover {
            background-color: #f8f9fa;
            border-left: 4px solid #0d6efd; /* Bootstrap primary color */
        }

        /* Badge size */
        .badge {
            font-size: 0.9rem;
            padding: 0.5em 0.75em;
        }
    </style>
}
