@{
    ViewData["Title"] = "Reports Dashboard";
}

<h2>Reports Dashboard</h2>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Stock Summary</h5>
                <p class="card-text">View complete stock details for all products including category, supplier, and low stock alerts.</p>
                <a asp-controller="Report" asp-action="StockSummary" class="btn btn-primary">View Stock Summary</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Low Stock Products</h5>
                <p class="card-text">View all products that have reached or fallen below the low stock threshold.</p>
                <a asp-controller="Report" asp-action="LowStock" class="btn btn-warning text-white">View Low Stock</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Transaction Summary</h5>
                <p class="card-text">View all transactions including purchases and sales.</p>
                <a asp-controller="Report" asp-action="TransactionSummary" class="btn btn-info text-white">View Transactions</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Profit & Loss</h5>
                <p class="card-text">View total sales, purchases, and calculate profit or loss.</p>
                <a asp-controller="Report" asp-action="ProfitLoss" class="btn btn-success">View Profit & Loss</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Orders By Date Range</h5>
                <p class="card-text">Filter and view orders within a specific date range.</p>
                <a asp-controller="Report" asp-action="OrdersByDateRange" class="btn btn-secondary">View Orders By Date</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Top Selling Products</h5>
                <p class="card-text">See top N selling products based on quantity sold.</p>
                <a asp-controller="Report" asp-action="TopSellingProducts" class="btn btn-dark text-white">View Top Selling</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Inventory Turnover</h5>
                <p class="card-text">Calculate inventory turnover ratio based on sales and average inventory.</p>
                <a asp-controller="Report" asp-action="InventoryTurnover" class="btn btn-primary">View Inventory Turnover</a>
            </div>
        </div>
    </div>
</div>
