@model IEnumerable<InventoryManagement.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<h2>Product List</h2>
@if (User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">Add New Product</a>
}


<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>SKU</th>
            <th>Name</th>
            <th>Description</th>
            <th>Unit Price</th>
            <th>Stock</th>
            <th>Category</th>
            <th>Supplier</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SKU</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>
                    @item.StockQuantity
                    @if (item.StockQuantity <= item.LowStockThreshold)
                    {
                        <span class="badge bg-danger ms-2">Low</span>
                    }
                </td>
                <td>@item.Category?.Name</td>
                <td>@item.Supplier?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-info">Details</a>
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning text-white ms-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger ms-1">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
