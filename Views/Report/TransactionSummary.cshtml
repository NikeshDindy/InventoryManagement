@model IEnumerable<InventoryManagement.Models.InventoryTransaction>

@{
    ViewData["Title"] = "Transaction Summary";

    // Quick stats (for dynamic UI cards)
    var totalTransactions = Model.Count();
    var totalPurchased = Model.Where(t => t.TransactionType == "IN").Sum(t => t.Quantity);
    var totalSold = Model.Where(t => t.TransactionType == "OUT").Sum(t => t.Quantity);
    var totalAdjusted = Model.Where(t => t.TransactionType == "Adjustment").Sum(t => t.Quantity);
}

<div class="container mt-4">

    <!-- Gradient Header -->
    <div class="p-4 mb-4 rounded text-white shadow-lg" style="background: linear-gradient(135deg, #6f42c1, #d63384);">
        <h2 class="fw-bold mb-0">📑 Transaction Summary</h2>
        <p class="mb-0">Track all inventory activities in real-time</p>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow border-0 h-100 text-center p-3 bg-primary text-white">
                <h5>Total Transactions</h5>
                <h2>@totalTransactions</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow border-0 h-100 text-center p-3 bg-success text-white">
                <h5>Total Purchased</h5>
                <h2>@totalPurchased</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow border-0 h-100 text-center p-3 bg-danger text-white">
                <h5>Total Sold</h5>
                <h2>@totalSold</h2>
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Transaction Type</th>
                    <th>Quantity</th>
                    <th>Date & Time</th>
                    <th>Performed By</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model)
                {
                    var badgeClass = transaction.TransactionType switch
                    {
                        "Purchase" => "badge bg-success",
                        "Sale" => "badge bg-danger",
                        "Adjustment" => "badge bg-warning text-dark",
                        _ => "badge bg-secondary"
                    };

                    <tr>
                        <td><strong>@transaction.Product?.Name</strong></td>
                        <td><span class="@badgeClass">@transaction.TransactionType</span></td>
                        <td>@transaction.Quantity</td>
                        <td>@transaction.Timestamp.ToString("g")</td>
                        <td>@transaction.PerformedBy?.FullName</td>
                        <td>@transaction.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .table-hover tbody tr:hover {
            background-color: #f8f9fa;
            transition: background-color 0.3s ease;
        }

        .card h2 {
            font-size: 2.2rem;
            font-weight: bold;
            margin: 0;
        }
    </style>
}
