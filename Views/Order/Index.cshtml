@model IEnumerable<InventoryManagement.Models.Order>
@{
    ViewData["Title"] = "Orders";
}
<h2>Orders</h2>
<p>
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
    <p>
        <a asp-action="CreatePurchaseOrder" class="btn btn-primary">Create Purchase Order</a>
    </p>

    }

<a asp-action="CreateSalesOrder" class="btn btn-secondary">Create Sales Order</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Order Number</th>
            <th>Order Type</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderNumber</td>
                <td>@order.OrderType</td>
                <td>@order.Status</td>
                <td>@order.CreatedAt.ToShortDateString()</td>
                <td>@order.TotalAmount.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.OrderId">Details</a>
                    @if (User.IsInRole("Manager") && order.Status == "Pending")
                    {
                        <a asp-action="ApproveOrder" asp-route-id="@order.OrderId" class="ms-2">Approve</a>
                    }
                    @if (order.Status != "Cancelled")
                    {
                        <a asp-action="CancelOrder" asp-route-id="@order.OrderId" class="ms-2">Cancel</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
