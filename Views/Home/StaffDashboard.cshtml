@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="container mt-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <p>Welcome, <strong>@User.Identity.Name</strong>!</p>

    <!-- First Row (4 cards max) -->
    <div class="row g-4 mt-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Products</h5>
                    <p class="card-text">Browse available products and stock levels.</p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-light mt-2">View</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Categories</h5>
                    <p class="card-text">See all product categories.</p>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-light mt-2">View</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Suppliers</h5>
                    <p class="card-text">View the supplier list.</p>
                    <a asp-controller="Supplier" asp-action="Index" class="btn btn-light mt-2">View</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Orders</h5>
                    <p class="card-text">View all purchase and sales orders.</p>
                    <a asp-controller="Order" asp-action="Index" class="btn btn-light mt-2">View</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row (Transactions card) -->
    <div class="row g-4 mt-4">
        <div class="col-md-3">
            <div class="card text-white bg-dark h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title">Transactions</h5>
                    <p class="card-text">View all inventory transactions.</p>
                    <a asp-controller="Transaction" asp-action="Index" class="btn btn-light mt-2">View</a>
                </div>
            </div>
        </div>
    </div>
</div>
