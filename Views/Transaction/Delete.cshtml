@model InventoryManagement.Models.InventoryTransaction

@{
    ViewData["Title"] = "Delete Transaction";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this transaction?
    <br />
    <strong>Warning:</strong> This will also revert stock changes.
</div>

<div class="mb-3">
    <label><strong>Product:</strong></label>
    <p>@Model.Product?.Name</p>
</div>

<div class="mb-3">
    <label><strong>Quantity:</strong></label>
    <p>@Model.Quantity</p>
</div>

<div class="mb-3">
    <label><strong>Transaction Type:</strong></label>
    <p>
        @if (Model.TransactionType == "IN")
        {
            <span class="badge bg-success">IN (Purchase)</span>
        }
        else
        {
            <span class="badge bg-danger">OUT (Sale)</span>
        }
    </p>
</div>

<div class="mb-3">
    <label><strong>Timestamp:</strong></label>
    <p>@Model.Timestamp.ToString("g")</p>
</div>

<div class="mb-3">
    <label><strong>Notes:</strong></label>
    <p>@Model.Notes</p>
</div>

<div class="mb-3">
    <label><strong>Performed By:</strong></label>
    <p>@Model.PerformedByUserId</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="TransactionId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
