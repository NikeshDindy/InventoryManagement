@model IEnumerable<InventoryManagement.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}
<h2>Suppliers</h2>
@if (User.IsInRole("Manager") || User.IsInRole("Admin"))
{
    <p><a asp-action="Create" class="btn btn-primary">Create New Supplier</a></p>

}

<table class="table table-striped">
    <thead>
        <tr><th>Name</th><th>Contact Info</th><th>Address</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Name</td>
                <td>@supplier.ContactInfo</td>
                <td>@supplier.Address</td>
                <td>
                    <a asp-action="Details" asp-route-id="@supplier.SupplierId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@supplier.SupplierId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@supplier.SupplierId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
