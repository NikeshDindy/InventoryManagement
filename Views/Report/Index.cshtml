@{
    ViewData["Title"] = "Reports Dashboard";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
    /* Base */
    body.light-mode {
        background: #f8f9fa;
        color: #212529;
    }

    body.dark-mode {
        background: #121212;
        color: #e0e0e0;
    }

    h2 {
        font-weight: 700;
        margin-bottom: 25px;
        color: #007bff;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
    }

    /* Card Styling */
    .report-card {
        border-radius: 15px;
        transition: all 0.3s ease-in-out;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .report-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        }

        .report-card i {
            font-size: 2rem;
            margin-bottom: 15px;
            transition: transform 0.3s ease;
        }

        .report-card:hover i {
            transform: scale(1.2);
        }

        .report-card .card-body {
            display: flex;
            flex-direction: column;
        }

        .report-card .card-text {
            flex-grow: 1;
            font-size: 0.9rem;
        }

    .btn-go {
        border-radius: 20px;
        font-weight: 600;
        transition: 0.3s ease;
    }

        .btn-go:hover {
            transform: scale(1.05);
        }

    /* Dark Mode */
    body.dark-mode .report-card {
        background: #1e1e1e;
        color: #e0e0e0;
    }

    body.dark-mode .btn-primary {
        background: #90caf9;
        border: none;
        color: #121212;
    }

    body.dark-mode .btn-warning {
        background: #ffb74d;
        border: none;
        color: #121212;
    }

    body.dark-mode .btn-info {
        background: #4dd0e1;
        border: none;
        color: #121212;
    }

    body.dark-mode .btn-success {
        background: #81c784;
        border: none;
        color: #121212;
    }

    body.dark-mode .btn-secondary {
        background: #b0bec5;
        border: none;
        color: #121212;
    }

    body.dark-mode .btn-dark {
        background: #616161;
        border: none;
        color: #fff;
    }

    /* Mini chart styling */
    .mini-chart {
        height: 80px !important;
    }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2><i class="fas fa-chart-bar"></i> Reports Dashboard</h2>
        <div>
            <button id="toggleDarkMode" class="btn btn-outline-dark btn-sm">
                <i class="fas fa-moon"></i>
            </button>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <!-- Stock Summary -->
        <div class="col-md-6 col-lg-4">
            <div class="card report-card shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column">
                    <i class="fas fa-boxes text-primary"></i>
                    <h5 class="card-title">Stock Summary</h5>
                    <p class="card-text">Complete stock details including category, supplier, and low stock alerts.</p>
                    <a asp-controller="Report" asp-action="StockSummary" class="btn btn-primary btn-go mt-auto">View</a>
                </div>
            </div>
        </div>

        <!-- Low Stock -->
        <div class="col-md-6 col-lg-4">
            <div class="card report-card shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column">
                    <i class="fas fa-exclamation-triangle text-warning"></i>
                    <h5 class="card-title">Low Stock Products</h5>
                    <p class="card-text">Products that reached or fallen below the low stock threshold.</p>
                    <a asp-controller="Report" asp-action="LowStock" class="btn btn-warning text-white btn-go mt-auto">View</a>
                </div>
            </div>
        </div>

        <!-- Transaction Summary with chart -->
        <div class="col-md-6 col-lg-4">
            <div class="card report-card shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column">
                    <i class="fas fa-exchange-alt text-info"></i>
                    <h5 class="card-title">Transaction Summary</h5>
                    <canvas id="transactionChart" class="mini-chart"></canvas>
                    <p class="card-text">All transactions including purchases and sales.</p>
                    <a asp-controller="Report" asp-action="TransactionSummary" class="btn btn-info text-white btn-go mt-auto">View</a>
                </div>
            </div>
        </div>

        <!-- Profit & Loss with chart -->
        <div class="col-md-6 col-lg-4">
            <div class="card report-card shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column">
                    <i class="fas fa-chart-line text-success"></i>
                    <h5 class="card-title">Profit & Loss</h5>
                    <canvas id="profitChart" class="mini-chart"></canvas>
                    <p class="card-text">Total sales, purchases, and profit or loss calculation.</p>
                    <a asp-controller="Report" asp-action="ProfitLoss" class="btn btn-success btn-go mt-auto">View</a>
                </div>
            </div>
        </div>

        <!-- Orders By Date -->
        <div class="col-md-6 col-lg-4">
            <div class="card report-card shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column">
                    <i class="fas fa-calendar-alt text-secondary"></i>
                    <h5 class="card-title">Orders By Date Range</h5>
                    <p class="card-text">Filter and view orders within a specific date range.</p>
                    <a asp-controller="Report" asp-action="OrdersByDateRange" class="btn btn-secondary btn-go mt-auto">View</a>
                </div>
            </div>
        </div>

        <!-- Top Selling -->
        <div class="col-md-6 col-lg-4">
            <div class="card report-card shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column">
                    <i class="fas fa-star" style="color: #FFD700;"></i>

                    <h5 class="card-title">Top Selling Products</h5>
                    <p class="card-text">See top N selling products based on quantity sold.</p>
                    <a asp-controller="Report" asp-action="TopSellingProducts" class="btn btn-dark text-white btn-go mt-auto">View</a>
                </div>
            </div>
        </div>

        <!-- Inventory Turnover -->
        <div class="col-md-6 col-lg-4">
            <div class="card report-card shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column">
                    <i class="fas fa-sync-alt text-primary"></i>
                    <h5 class="card-title">Inventory Turnover</h5>
                    <p class="card-text">Inventory turnover ratio based on sales and average inventory.</p>
                    <a asp-controller="Report" asp-action="InventoryTurnover" class="btn btn-primary btn-go mt-auto">View</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Mini Chart: Transactions
    new Chart(document.getElementById("transactionChart"), {
        type: 'line',
        data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
            datasets: [{
                label: 'Transactions',
                data: [12, 19, 14, 22, 30],
                borderColor: 'rgba(54, 162, 235, 0.8)',
                backgroundColor: 'rgba(54, 162, 235, 0.2)',
                fill: true,
                tension: 0.4
            }]
        },
        options: { plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { display: false } } }
    });

    // Mini Chart: Profit & Loss
    new Chart(document.getElementById("profitChart"), {
        type: 'bar',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr'],
            datasets: [{
                label: 'Profit',
                data: [300, 500, 400, 600],
                backgroundColor: 'rgba(75, 192, 192, 0.7)'
            }, {
                label: 'Loss',
                data: [200, 300, 250, 350],
                backgroundColor: 'rgba(255, 99, 132, 0.7)'
            }]
        },
        options: { plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { display: false } } }
    });

    // Dark Mode Toggle
    const body = document.body;
    const toggleBtn = document.getElementById("toggleDarkMode");

    toggleBtn.addEventListener("click", () => {
        body.classList.toggle("dark-mode");
        body.classList.toggle("light-mode");
        toggleBtn.innerHTML = body.classList.contains("dark-mode")
            ? '<i class="fas fa-sun"></i>'
            : '<i class="fas fa-moon"></i>';
    });

    // Default to light mode
    body.classList.add("light-mode");
</script>
