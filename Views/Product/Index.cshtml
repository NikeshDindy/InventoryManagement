@model IEnumerable<InventoryManagement.ViewModels.ProductDto>

@{
    ViewData["Title"] = "Products";
}

<h2>Product List</h2>

@if (User.IsInRole("Admin") || User.IsInRole("Manager"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">Add New Product</a>
}

<!-- 🔹 Card Grid -->
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 border-0 product-card">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">SKU: @item.SKU</h6>
                    <p class="card-text">@item.Description</p>

                    <p>
                        <strong>Price:</strong> @item.UnitPrice.ToString("C") <br />
                        <strong>Stock:</strong>
                        @item.StockQuantity
                        @if (item.StockQuantity <= item.LowStockThreshold)
                        {
                            <span class="badge bg-danger ms-1">Low</span>
                        }
                        else
                        {
                            <span class="badge bg-success ms-1">OK</span>
                        }
                        <br />
                        <strong>Category:</strong> @item.CategoryName <br />
                        <strong>Supplier:</strong> @item.SupplierName
                    </p>

                    <div class="mt-3">
                        <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-info">Details</a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning text-white ms-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger ms-1">Delete</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- 🔹 Card Hover Styling -->
<style>
    .product-card {
        transition: transform 0.2s ease, box-shadow 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 20px rgba(0,0,0,0.2);
        }
</style>
