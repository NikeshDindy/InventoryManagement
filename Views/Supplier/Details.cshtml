@model InventoryManagement.Models.Supplier
@{
    ViewData["Title"] = "Supplier Details";
}
<h2>Supplier: @Model.Name</h2>

<dl class="row">
    <dt class="col-sm-2">Contact Info</dt>
    <dd class="col-sm-10">@Model.ContactInfo</dd>

    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@Model.Address</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>
