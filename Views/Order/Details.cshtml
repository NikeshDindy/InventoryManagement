@model InventoryManagement.ViewModels.OrderDetailDto

@{
    ViewData["Title"] = "Order Details";
}

<h2>Order Details - @Model.OrderNumber</h2>

<p><strong>Order Type:</strong> @Model.OrderType</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Total Amount:</strong> @Model.TotalAmount.ToString("C")</p>
<p><strong>Supplier:</strong> @Model.SupplierName</p>
<p><strong>Created By:</strong> @Model.CreatedByName</p>
<p><strong>Created At:</strong> @Model.CreatedAt.ToString("g")</p>

<h3>Order Items</h3>
<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetails ?? new List<InventoryManagement.Models.OrderDetail>())
        {
            <tr>
                <td>@item.Product?.Name ?? "N/A"</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.LineTotal.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<h3>Inventory Transactions</h3>
<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Type</th>
            <th>Timestamp</th>
            <th>Performed By</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tx in Model.InventoryTransactions ?? new List<InventoryManagement.Models.InventoryTransaction>())
        {
            <tr>
                <td>@tx.Product?.Name ?? "N/A"</td>
                <td>@tx.Quantity</td>
                <td>@tx.TransactionType</td>
                <td>@tx.Timestamp.ToString("g")</td>
                <td>@tx.PerformedBy?.UserName ?? "N/A"</td>
                <td>@tx.Notes</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @if (Model.Status == "Pending")
    {
        <form asp-action="ApproveOrder" method="post" style="display:inline">
            <input type="hidden" name="id" value="@Model.OrderId" />
            <button type="submit" class="btn btn-success">Approve</button>
        </form>
        <form asp-action="CancelOrder" method="post" style="display:inline">
            <input type="hidden" name="id" value="@Model.OrderId" />
            <button type="submit" class="btn btn-danger">Cancel</button>
        </form>
    }
</div>

<a asp-action="Index" class="btn btn-secondary mt-2">Back to Orders</a>
